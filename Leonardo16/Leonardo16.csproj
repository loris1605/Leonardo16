    <ProjectReference Include="..\ControlStyles\ControlStyles.csproj" />
    <ProjectReference Include="..\Models\Models.csproj" />
    <ProjectReference Include="..\SysNet\SysNet.csproj" />

	  <!-- Caricamento posticipato: compila la DLL e FORZA la copia in output -->
	  <ProjectReference Include="..\Login\Login.csproj">
		  <!-- Impedisce al compilatore C# di vedere le classi del Login all'avvio -->
		  <ReferenceOutputAssembly>false</ReferenceOutputAssembly>

		  <!-- DICE A MSBUILD: Tratta l'output di questo progetto come se fosse Contenuto Libero -->
		  <OutputItemType>Content</OutputItemType>

		  <!-- Forza la copia fisica dei file compilati nella cartella bin\Debug\... dell'app principale -->
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </ProjectReference>
	  
