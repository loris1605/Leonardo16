<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:ui="using:ControlStyles"
             xmlns:material="using:Material.Icons.Avalonia"
             KeyboardNavigation.TabNavigation="Cycle"
             Background="#F3F3F3"
             x:CompileBindings="False"
             x:Class="Views.EntraSocioAnagraficaView"
             x:Name="Root">

    <Grid x:Name="MainGrid" >
    
        <HeaderedContentControl BorderBrush="Black"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                x:Name="AnagraficaBorder"
                                BorderThickness="1"
                                CornerRadius="5"
                                Margin="3"
                                Background="Transparent">

            <HeaderedContentControl.Header>
                <TextBlock Text=" IDENTIFICAZIONE "
                           Foreground="Black"
                           Margin="3"
                           HorizontalAlignment="Center"/>
            </HeaderedContentControl.Header>

            <Grid x:Name="InputGrid"
                      Grid.Row="1"
                      Margin="10">
                    
                <Grid.RowDefinitions>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto" MinHeight="35"/>
                    <RowDefinition Height="Auto" MinHeight="35"/>
                    <RowDefinition Height="Auto" MinHeight="35"/>
                    <RowDefinition Height="Auto" MinHeight="35"/>
                    <RowDefinition Height="Auto" MinHeight="35"/>
                    <RowDefinition Height="Auto" MinHeight="35"/>
                 </Grid.RowDefinitions>    
                 
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MaxWidth="200"/>
                </Grid.ColumnDefinitions>

                <ui:UiLabelForGrid Text="TESSERA (F5) :"
                                   Margin="5,10,5,10"
                                   Grid.Row="1"/>

                <ui:UiIntegerTextBox Grid.Row="1"
                                    x:Name="TesseraBox"
                                    Grid.Column="1"
                                    Margin="5,2,5,2"
                                    VerticalAlignment="Center"/>

                <ui:UiLabelForGrid Text="COGNOME :"
                                   Margin="5,10,5,10"
                                   Grid.Row="2"/>

                <ui:UiLabelForGrid Text="{Binding}"
                                   Foreground="Blue"
                                   Margin="5,10,5,10"
                                   Grid.Row="2"
                                   Grid.Column="1"/>

                <ui:UiLabelForGrid Text="NOME :"
                                   Margin="5,10,5,10"
                                   Grid.Row="3"/>

                <ui:UiLabelForGrid Text="{Binding}"
                                   Foreground="Blue"
                                   Margin="5,10,5,10"
                                   Grid.Row="3"
                                   Grid.Column="1"/>

                <ui:UiLabelForGrid Text="ETA' :"
                                   Margin="5,10,5,10"
                                   Grid.Row="4"/>

                <ui:UiLabelForGrid Text="{Binding}"
                                   Foreground="Blue"
                                   Margin="5,10,5,10"
                                   Grid.Row="4"
                                   Grid.Column="1"/>

                <ui:UiLabelForGrid Text="CODICE SOCIO :"
                                   Margin="5,10,5,10"
                                   Grid.Row="5"/>

                <ui:UiLabelForGrid Text="{Binding}"
                                   Foreground="Blue"
                                   Margin="5,10,5,10"
                                   Grid.Row="5"
                                   Grid.Column="1"/>

                <ui:UiLabelForGrid Text="POSIZIONE :"
                                   Margin="5,10,5,10"
                                   Grid.Row="6"/>

                <ui:UiIntegerTextBox Grid.Row="6"
                                     x:Name="PosizioneBox"
                                     Grid.Column="1"
                                     Margin="5,2,5,2"
                                     VerticalAlignment="Center"/>


            </Grid>

            
                        
        </HeaderedContentControl> 
    
    </Grid>
  
</UserControl>
